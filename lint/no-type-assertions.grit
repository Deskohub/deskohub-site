engine biome(1.0)
language js(typescript, jsx)

// Packages and Workspace code decode or narrow values instead of asserting their
// types. Only tests, fixtures, and testing helpers under the remaining large
// feature directories stay exempt while they are migrated.
file($name, $body) where {
  or {
    and {
      $name <: r".*packages/.*\.(?:ts|tsx|mts|cts)$",
      not $name <: r".*/generated/.*"
    },
    and {
      $name <: r".*apps/deskohub-workspace/.*\.(?:ts|tsx|mts|cts)$",
      not $name <: r".*apps/deskohub-workspace/e2e/.*",
      not $name <: r".*/(?:generated|paraglide)/.*",
      not and {
        or {
          $name <: r".*apps/deskohub-workspace/features/(?:account|email-campaigns)/.*",
          and {
            $name <: r".*apps/deskohub-workspace/features/checkout/.*",
            not $name <: r".*apps/deskohub-workspace/features/checkout/(?:actions/.*|backend/(?:analytics|fio|repositories)/.*|(?:checkout-quote|workspace-table-map)\.test\.(?:ts|tsx|mts|cts))$"
          }
        },
        or {
          $name <: r".*/testing/.*",
          $name <: r".*(?:\.(?:test|spec|pw|test-utils|browser-harness)|-fixture|\.fixture)\.(?:ts|tsx|mts|cts)$"
        }
      }
    }
  },
  // Every `as` assertion has the `as` keyword and every angle-bracket assertion a `<`.
  $body <: r"(?s).*(?:\bas\b|<).*",
  $body <: contains bubble {
    or {
      TsAsExpression() as $assertion where {
        not $assertion <: `$value as const`
      },
      TsTypeAssertionExpression(ty = $type) as $assertion where {
        not $type <: r"^const$"
      }
    } where {
      register_diagnostic(
        span = $assertion,
        message = "[anti-slop/no-type-assertions] Decode with Schema or narrow the value. Const assertions are allowed with `as const` and `<const>`.",
        severity = "error"
      )
    }
  }
}
