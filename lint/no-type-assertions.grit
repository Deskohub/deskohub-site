engine biome(1.0)
language js(typescript, jsx)

// Packages and Workspace code decode or narrow values instead of asserting their
// types. Only tests, fixtures, and testing helpers under the remaining large
// feature directories stay exempt while they are migrated.
file($name, $body) where {
  or {
    and {
      $name <: r".*packages/.*\.(?:ts|tsx|mts|cts)$",
      not $name <: r".*/generated/.*"
    },
    and {
      $name <: r".*apps/deskohub-workspace/(?:(?:app|db|emails|features|scripts|shared)/.*|[^/]+)\.(?:ts|tsx|mts|cts)$",
      not $name <: r".*/(?:generated|paraglide)/.*",
      not $name <: r".*apps/deskohub-workspace/features/(?:account|accounting|admin-cli|administration|checkout|discounts|email-campaigns|passes|referrals|reservation)/(?:.*/)?testing/.*",
      not $name <: r".*apps/deskohub-workspace/features/(?:account|accounting|admin-cli|administration|checkout|discounts|email-campaigns|passes|referrals|reservation)/.*(?:\.(?:test|spec|pw|test-utils|browser-harness)|-fixture|\.fixture)\.(?:ts|tsx|mts|cts)$"
    }
  },
  // Every `as` assertion has the `as` keyword and every angle-bracket assertion a `<`.
  $body <: r"(?s).*(?:\bas\b|<).*",
  $body <: contains bubble {
    or {
      TsAsExpression() as $assertion where {
        not $assertion <: `$value as const`
      },
      TsTypeAssertionExpression() as $assertion
    } where {
      register_diagnostic(
        span = $assertion,
        message = "[anti-slop/no-type-assertions] Decode with Schema or narrow the value instead of asserting its type; only `as const` is allowed.",
        severity = "error"
      )
    }
  }
}
