engine biome(1.0)
language js(typescript, jsx)

// Packages and Workspace production code decode or narrow values instead of
// asserting their types.
file($name, $body) where {
  or {
    and {
      $name <: r".*packages/.*\.(?:ts|tsx|mts|cts)$",
      not $name <: r".*/generated/.*"
    },
    and {
      $name <: r".*apps/deskohub-workspace/(?:(?:app|db|emails|features|scripts|shared)/.*|[^/]+)\.(?:ts|tsx|mts|cts)$",
      not $name <: r".*/(?:generated|paraglide|testing)/.*",
      not $name <: r".*(?:\.(?:test|spec|pw|test-utils|browser-harness)|-fixture|\.fixture)\.(?:ts|tsx|mts|cts)$"
    }
  },
  // Every `as` assertion has the `as` keyword and every angle-bracket assertion a `<`.
  $body <: r"(?s).*(?:\bas\b|<).*",
  $body <: contains bubble {
    or {
      TsAsExpression() as $assertion where {
        not $assertion <: `$value as const`
      },
      TsTypeAssertionExpression() as $assertion
    } where {
      register_diagnostic(
        span = $assertion,
        message = "[anti-slop/no-type-assertions] Decode with Schema or narrow the value instead of asserting its type; only `as const` is allowed.",
        severity = "error"
      )
    }
  }
}
